{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "misroute/discover.json",
 "title": "misroute discover output",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "command": {
   "type": "string"
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "model",
     "mode",
     "trials",
     "wrong_rate",
     "hedge_rate",
     "write_hedge_rate",
     "failures",
     "matrix"
    ],
    "properties": {
     "model": {
      "type": "string"
     },
     "mode": {
      "enum": [
       "json",
       "code"
      ]
     },
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "hedge_rate": {
      "type": "number"
     },
     "write_hedge_rate": {
      "type": "number"
     },
     "failures": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "unanswered": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "matrix": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "additionalProperties": {
        "type": "integer"
       }
      }
     }
    }
   }
  },
  "spots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "a",
     "b",
     "score",
     "signals",
     "write",
     "gate_failed",
     "thin",
     "directions",
     "where",
     "ci95"
    ],
    "properties": {
     "a": {
      "type": "string"
     },
     "b": {
      "type": "string"
     },
     "score": {
      "type": "number"
     },
     "signals": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "write": {
      "type": "boolean"
     },
     "gate_failed": {
      "type": "boolean"
     },
     "thin": {
      "type": "boolean"
     },
     "directions": {
      "type": "object",
      "additionalProperties": {
       "type": "integer"
      }
     },
     "where": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "errors": {
      "type": "integer",
      "description": "most wrong or hedged requests between the pair in one model and mode"
     },
     "flagged": {
      "type": "boolean",
      "description": "errors at least 6, the thesis flag rule"
     },
     "ci95": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Wilson 95% interval for the signal the score came from"
     }
    }
   }
  },
  "gate_failed": {
   "type": "array"
  },
  "near_misses": {
   "type": "array"
  },
  "removal": {
   "type": "object"
  },
  "short": {
   "type": "object"
  },
  "untested": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "spent": {
   "type": "number"
  },
  "run": {
   "type": "string"
  },
  "roles_warning": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "request_source": {
   "enum": [
    "description",
    "spec"
   ]
  },
  "by_language": {
   "type": "object",
   "description": "Wrong and error rates per request language, empty with one language",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "error_rate": {
      "type": "number"
     }
    }
   }
  },
  "by_kind": {
   "type": "object",
   "description": "Wrong and error rates per request kind, empty with one kind",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "error_rate": {
      "type": "number"
     }
    }
   }
  },
  "unrouted": {
   "type": "array",
   "description": "Tools whose requests ended with no tool call, ranked by rate",
   "items": {
    "type": "object",
    "required": [
     "tool",
     "rate",
     "count",
     "trials",
     "where",
     "example"
    ],
    "properties": {
     "tool": {
      "type": "string"
     },
     "rate": {
      "type": "number"
     },
     "count": {
      "type": "integer"
     },
     "trials": {
      "type": "integer"
     },
     "where": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "example": {
      "type": "string"
     }
    }
   }
  }
 },
 "required": [
  "schema_version",
  "command",
  "cells",
  "spots",
  "gate_failed",
  "untested",
  "spent"
 ],
 "additionalProperties": true
}