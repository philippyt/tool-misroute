{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "misroute/discover.json",
 "title": "misroute discover output",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 2
  },
  "command": {
   "type": "string"
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "model",
     "mode",
     "trials",
     "wrong_rate",
     "hedge_rate",
     "write_hedge_rate",
     "failures",
     "matrix"
    ],
    "properties": {
     "model": {
      "type": "string"
     },
     "mode": {
      "enum": [
       "json",
       "code"
      ]
     },
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "hedge_rate": {
      "type": "number"
     },
     "write_hedge_rate": {
      "type": "number"
     },
     "failures": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "unanswered": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "matrix": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "additionalProperties": {
        "type": "integer"
       }
      }
     },
     "accuracy": {
      "type": "number",
      "description": "share of trials whose first choice was the target alone"
     },
     "reached_rate": {
      "type": "number",
      "description": "share of trials that called the target at some point within max_turns"
     },
     "bad_args_rate": {
      "type": "number",
      "description": "share of trials with a call whose arguments break the tool's input schema, apart from the tool choice"
     },
     "bad_args": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "problem": {
         "type": "string"
        },
        "trials": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  "spots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "a",
     "b",
     "score",
     "signals",
     "write",
     "thin",
     "directions",
     "where",
     "ci95",
     "flagged",
     "one_wording",
     "templates"
    ],
    "properties": {
     "a": {
      "type": "string"
     },
     "b": {
      "type": "string"
     },
     "score": {
      "type": "number"
     },
     "signals": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "write": {
      "type": "boolean"
     },
     "thin": {
      "type": "boolean"
     },
     "directions": {
      "type": "object",
      "additionalProperties": {
       "type": "integer"
      }
     },
     "where": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "errors": {
      "type": "integer",
      "description": "most wrong or hedged requests between the pair in one model and mode"
     },
     "flagged": {
      "type": "boolean",
      "description": "errors at least 6, the thesis flag rule, over at least 2 request templates"
     },
     "ci95": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Wilson 95% interval for the signal the score came from, counting request templates, not trials"
     },
     "templates": {
      "type": "integer",
      "description": "distinct request templates behind those errors"
     },
     "one_wording": {
      "type": "boolean",
      "description": "errors at least 6 from a single request template, one observation, not flagged"
     }
    }
   }
  },
  "near_misses": {
   "type": "array"
  },
  "removal": {
   "type": "object"
  },
  "short": {
   "type": "object"
  },
  "untested": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "spent": {
   "type": "number"
  },
  "run": {
   "type": "string"
  },
  "roles_warning": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "request_source": {
   "enum": [
    "description",
    "spec"
   ]
  },
  "by_language": {
   "type": "object",
   "description": "Wrong and error rates per request language, empty with one language",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "error_rate": {
      "type": "number"
     }
    }
   }
  },
  "by_kind": {
   "type": "object",
   "description": "Wrong and error rates per request kind, empty with one kind",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "trials": {
      "type": "integer"
     },
     "wrong_rate": {
      "type": "number"
     },
     "error_rate": {
      "type": "number"
     }
    }
   }
  },
  "unrouted": {
   "type": "array",
   "description": "Tools whose requests ended with no tool call, ranked by rate",
   "items": {
    "type": "object",
    "required": [
     "tool",
     "rate",
     "count",
     "trials",
     "where",
     "example"
    ],
    "properties": {
     "tool": {
      "type": "string"
     },
     "rate": {
      "type": "number"
     },
     "count": {
      "type": "integer"
     },
     "trials": {
      "type": "integer"
     },
     "where": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "example": {
      "type": "string"
     }
    }
   }
  },
  "effect_unknown": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rejected_requests": {
   "type": "object",
   "description": "per tool, each written request the validator dropped, the tool it picked and its reason",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "request": {
       "type": "string"
      },
      "picked": {
       "type": [
        "string",
        "null"
       ]
      },
      "reason": {
       "type": "string"
      }
     }
    }
   }
  },
  "lookup_tools": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "configured entry point tools whose calls are not scored as choices"
  },
  "lookup_candidates": {
   "type": "array",
   "description": "tools called on the way to several targets, likely entry points to list under lookup_tools",
   "items": {
    "type": "object",
    "properties": {
     "tool": {
      "type": "string"
     },
     "trials": {
      "type": "integer"
     },
     "targets": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "max_turns": {
   "type": "integer"
  },
  "usage": {
   "type": "object",
   "description": "measured calls, tokens and dollars per model",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "roles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "calls": {
      "type": "integer"
     },
     "cached": {
      "type": "integer"
     },
     "tokens_in": {
      "type": "integer"
     },
     "tokens_out": {
      "type": "integer"
     },
     "cost_usd": {
      "type": "number"
     }
    }
   }
  },
  "estimate": {
   "type": "object",
   "description": "the estimate shown before the run, a guide and not a limit"
  }
 },
 "required": [
  "schema_version",
  "command",
  "cells",
  "spots",
  "untested",
  "spent"
 ],
 "additionalProperties": true
}
