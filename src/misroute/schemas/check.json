{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "misroute/check.json",
 "title": "misroute check output",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "command": {
   "type": "string"
  },
  "tool": {
   "type": "string"
  },
  "verdict": {
   "enum": [
    "better",
    "worse",
    "no_difference",
    "insufficient_data"
   ]
  },
  "reason": {
   "type": "string"
  },
  "baseline_kind": {
   "enum": [
    "neutral",
    "description"
   ]
  },
  "wrong_rate": {
   "type": "object",
   "additionalProperties": {
    "type": "number"
   }
  },
  "hedge_rate": {
   "type": "object",
   "additionalProperties": {
    "type": "number"
   }
  },
  "leakage": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "trials": {
   "type": "integer"
  },
  "held_out": {
   "type": "boolean"
  },
  "cost_usd": {
   "type": "number"
  },
  "templates": {
   "type": "integer",
   "description": "request templates compared, the unit of the test"
  },
  "discordant_templates": {
   "type": "integer"
  },
  "p": {
   "type": "number",
   "description": "exact two sided sign flip over per template differences"
  },
  "p_trial_midp": {
   "type": "number",
   "description": "trial level mid p McNemar, reported only"
  },
  "fixed": {
   "type": "integer"
  },
  "broke": {
   "type": "integer"
  },
  "diff": {
   "type": "number",
   "description": "error rate change, treatment minus baseline"
  },
  "ci": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "roles_warning": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "looks": {
   "type": "integer",
   "description": "verdicts this held out set has given, p is multiplied by it"
  }
 },
 "required": [
  "schema_version",
  "command",
  "tool",
  "verdict",
  "reason",
  "trials",
  "held_out",
  "cost_usd"
 ],
 "additionalProperties": true
}
