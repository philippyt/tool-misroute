{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "misroute/fix.json",
 "title": "misroute fix output",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": 1
  },
  "command": {
   "type": "string"
  },
  "pairs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "pair",
     "model",
     "mode",
     "baseline_kind",
     "errors",
     "verdict",
     "flagged",
     "n"
    ],
    "properties": {
     "pair": {
      "type": "string"
     },
     "baseline_kind": {
      "enum": [
       "neutral",
       "description"
      ]
     },
     "errors": {
      "type": "object",
      "required": [
       "original",
       "baseline",
       "clause"
      ]
     },
     "verdict": {
      "type": "string"
     },
     "templates": {
      "type": "integer",
      "description": "request templates compared, the unit of the test"
     },
     "discordant_templates": {
      "type": "integer"
     },
     "p": {
      "type": "number",
      "description": "exact two sided sign flip over per template differences"
     },
     "p_trial_midp": {
      "type": "number",
      "description": "trial level mid p McNemar, reported only"
     },
     "fixed": {
      "type": "integer"
     },
     "broke": {
      "type": "integer"
     },
     "diff": {
      "type": "number",
      "description": "error rate change, treatment minus baseline"
     },
     "ci": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "hedge_p": {
      "type": "number"
     }
    }
   }
  },
  "across": {
   "type": "array"
  },
  "spent": {
   "type": "number"
  },
  "roles_warning": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "schema_version",
  "command",
  "pairs",
  "across"
 ],
 "additionalProperties": true
}
